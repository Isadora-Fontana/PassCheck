# Valores locais de referência; JWT_SECRET é obrigatório e não possui padrão.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Caminho relativo à pasta backend/, independentemente do diretório de execução.
DATABASE_PATH=./data/passcheck.sqlite
# Origens exatas, separadas por vírgula, sem barra final ou curingas.
# Em production esta variável é obrigatória.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# Gere 32–64 bytes aleatórios em base64url; nunca versione a chave real.
JWT_SECRET=
JWT_TTL_SECONDS=900

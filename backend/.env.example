# Valores locais de referência; JWT_SECRET é obrigatório e não possui padrão.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Padrão preserva SQLite. Use postgres apenas no ambiente validado para o corte.
DATABASE_ENGINE=sqlite
# Caminho relativo à pasta backend/, independentemente do diretório de execução.
DATABASE_PATH=./data/passcheck.sqlite
# Origens exatas, separadas por vírgula, sem barra final ou curingas.
# Em production esta variável é obrigatória.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173,http://127.0.0.1:4173,http://localhost:3000,http://127.0.0.1:3000
# Gere 32–64 bytes aleatórios em base64url; nunca versione a chave real.
JWT_SECRET=
JWT_TTL_SECONDS=900
# Build da PWA servido pela API; relativo à pasta backend/.
FRONTEND_DIST=../frontend/dist
# 0 para acesso direto. 1 somente atrás de um proxy que substitui X-Forwarded-For
# e com acesso direto à origem bloqueado/restrito (como no compose.yaml).
TRUST_PROXY_HOPS=0

# PostgreSQL: usado pela API/CLIs quando DATABASE_ENGINE=postgres.
# db:pg:* sempre usa PostgreSQL, independentemente do motor da API.
# Copie a URI de conexão do provedor, sem query string; nunca versione a senha.
DATABASE_URL=
# Schema privado, fora do schema public normalmente exposto pela Data API.
DATABASE_SCHEMA=passcheck
# verify-full é o padrão e obrigatório remotamente em produção.
# require: TLS sem validar certificado, somente NODE_ENV=development/test, por opção explícita.
# disable: apenas em loopback + development/test.
PG_SSL_MODE=verify-full
# Opcional: caminho para o certificado CA do provedor, quando necessário.
PG_SSL_CA_FILE=
PG_POOL_MAX=5
PG_CONNECT_TIMEOUT_MS=5000
PG_IDLE_TIMEOUT_MS=30000
PG_STATEMENT_TIMEOUT_MS=15000
PG_LOCK_TIMEOUT_MS=5000

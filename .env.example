# Docker Compose: segredo próprio do servidor, nunca versionar o .env real.
JWT_SECRET=
JWT_TTL_SECONDS=900
PUBLIC_ORIGIN=http://localhost:3000
# Para HTTPS: DOMAIN=passcheck.seudominio.com e PUBLIC_ORIGIN=https://passcheck.seudominio.com
DOMAIN=localhost
# Seleção explícita do motor no container; SQLite permanece o padrão.
DATABASE_ENGINE=sqlite
# Preencher privadamente apenas para PostgreSQL. Nunca versione a URI real.
DATABASE_URL=
DATABASE_SCHEMA=passcheck
PG_POOL_MAX=5
